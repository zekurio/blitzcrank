{
  "name": "blitzcrank-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic webhook gateway for the Seerr/Arr/Jellyfin homelab stack, built on Pi Durable",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "auth": "pnpm --filter blitzcrank auth",
    "build": "pnpm -r build",
    "dev": "pnpm --filter blitzcrank dev",
    "dev:mcp": "pnpm --filter @blitzcrank/mcp dev",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "start": "pnpm --filter blitzcrank start",
    "start:mcp": "pnpm --filter @blitzcrank/mcp start",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
