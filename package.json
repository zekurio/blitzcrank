{
  "name": "blitzcrank",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic webhook gateway for the Seerr/Arr/Jellyfin homelab stack, built on the pi SDK",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "e2e:issue": "tsx scripts/e2e-issue.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@hono/node-server": "^2.0.12",
    "croner": "^10.0.1",
    "hono": "^4.9.0",
    "typebox": "1.1.38",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
