{
  "name": "blitzcrank",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic webhook gateway for the Seerr/Arr/Jellyfin homelab stack, built on the pi SDK",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "e2e:issue": "tsx scripts/e2e-issue.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@hono/node-server": "^1.19.0",
    "croner": "^10.0.1",
    "hono": "^4.9.0",
    "typebox": "1.1.38",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
