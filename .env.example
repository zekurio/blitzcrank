# blitzcrank
BLITZCRANK_PORT=8484
# Persistent state: the host job journal, case/evidence files, and Pi Durable
# SQLite conversations. One service process owns this directory.
#BLITZCRANK_DATA_DIR=data
# Automation definition directory
#BLITZCRANK_AUTOMATIONS_DIR=automations
# Optional shared secret; Seerr must send it as the Authorization header
BLITZCRANK_WEBHOOK_SECRET=change-me
# Required model: provider/model with optional :thinking suffix.
# No built-in model choice. Example: openai/gpt-6-astra:medium.
# Thinking: off|minimal|low|medium|high|xhigh|max, default medium,
# limited to levels supported by the selected model.
BLITZCRANK_MODEL=
# Automations inherit BLITZCRANK_MODEL unless overridden.
#BLITZCRANK_AUTOMATION_MODEL=
# JSON object mapping automation names to per-automation model overrides.
#BLITZCRANK_AUTOMATION_MODELS={"stale-import-handler":"provider/model:high"}
# Language for public comments on Seerr issues (default: German)
#BLITZCRANK_LANGUAGE=German

# Provider API keys need no login command:
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
# For ChatGPT subscription auth, use `pnpm auth login openai`.
# With this .env: pnpm exec tsx --env-file=.env src/cli.ts auth login openai
# Auth commands do not need service credentials or a model.
# Credentials default to <BLITZCRANK_DATA_DIR>/auth.json (data/auth.json).
# Keep it writable for token refresh; the installation UUID lives beside it
# at auth.json.device-id. No ambient Pi auth or models config is loaded.
#BLITZCRANK_AUTH_PATH=/var/lib/blitzcrank/auth.json
# Optional explicit models.json for custom providers
#BLITZCRANK_MODELS_PATH=

# Seerr (Jellyseerr/Overseerr) — required
SEERR_URL=http://jellyseerr.local:5055
SEERR_API_KEY=
# Seerr user the bot comments as (X-Api-User) + its display name (loop guard)
#SEERR_BOT_USER_ID=2
#SEERR_BOT_USERNAME=blitzcrank

# Optional services — tools are only registered when configured
SONARR_URL=http://sonarr.local:8989
SONARR_API_KEY=

RADARR_URL=http://radarr.local:7878
RADARR_API_KEY=

SABNZBD_URL=http://sabnzbd.local:8080
SABNZBD_API_KEY=

JELLYFIN_URL=http://jellyfin.local:8096
JELLYFIN_API_KEY=

# Discord — automation reports, /automation, and optional support inbox.
# Unset token = no bot and no command registration. Guild + watch channel are
# required when set. Guild commands are replaced on startup.
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=
# Text channel that holds the per-automation report threads (admin-only)
#DISCORD_WATCH_CHANNEL_ID=
# Optional text channel. Quick media questions get read-only replies inline;
# troubleshooting and changes open private threads with typed mutations and
# bounded search over prior Seerr/Discord sessions. Channel access authorizes
# both, so restrict it to trusted users. Enable Message Content Intent.
#DISCORD_INBOX_CHANNEL_ID=
# Model for Discord answers and private threads. Falls back to BLITZCRANK_MODEL.
#BLITZCRANK_DISCORD_MODEL=
# Cheap triage model with no service/read tools. Falls back to the chat model.
#BLITZCRANK_DISCORD_TRIAGE_MODEL=
# Extra roles allowed to trigger automations; administrators always may
#DISCORD_ADMIN_ROLE_IDS=

# Web provider for issue runs and Discord conversations: firecrawl or none
# (default). Grants the read-only web_search (snippets) and web_extract (one
# result page) tools; web_extract only opens URLs web_search returned during
# the same run.
#BLITZCRANK_WEB_PROVIDER=none
# Firecrawl uses its hosted v2 API. Custom/self-hosted endpoints are rejected
# because Blitzcrank cannot enforce their DNS and redirect network policy.
#FIRECRAWL_API_KEY=fc-...

# media_probe (ffprobe) requires media roots.
# media_frames (ffmpeg) also requires image input support from the selected model.
# Colon-separated absolute directories the probe may read (library + completed
# downloads). Everything outside them is rejected; symlinks are resolved first.
# ffprobe must be on PATH.
#BLITZCRANK_MEDIA_ROOTS=/mnt/media:/mnt/downloads/complete
