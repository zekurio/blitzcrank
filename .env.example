# blitzcrank
BLITZCRANK_PORT=8484
# Persistent state: case files, carried-over evidence, and the per-issue agent
# session transcripts that follow-up runs resume (also feeds thread_history_search)
#BLITZCRANK_DATA_DIR=data
# Automation definition directory
#BLITZCRANK_AUTOMATIONS_DIR=automations
# Optional shared secret; Seerr must send it as the Authorization header
BLITZCRANK_WEBHOOK_SECRET=change-me
# Model for issue runs: provider/model with optional :thinking suffix
# (off|minimal|low|medium|high|xhigh|max, default medium)
#BLITZCRANK_MODEL=anthropic/claude-sonnet-4-5:medium
# Default model for automations; falls back to BLITZCRANK_MODEL when unset.
#BLITZCRANK_AUTOMATION_MODEL=openai-codex/gpt-5.6-terra:high
# JSON object mapping automation names to per-automation model overrides.
#BLITZCRANK_AUTOMATION_MODELS={"stale-import-handler":"provider/model:high"}
# Language for public comments on Seerr issues (default: German)
#BLITZCRANK_LANGUAGE=German

# LLM provider auth — either a provider API key env var:
ANTHROPIC_API_KEY=
# ...or a pi auth.json (API keys and OAuth credentials, e.g. openai-codex
# subscription auth). Must be writable: OAuth tokens refresh in place.
# Defaults to ~/.pi/agent/auth.json when unset.
#BLITZCRANK_AUTH_PATH=/var/lib/blitzcrank/auth.json
# Optional pi models.json for custom providers
#BLITZCRANK_MODELS_PATH=

# Seerr (Jellyseerr/Overseerr) — required
SEERR_URL=http://jellyseerr.local:5055
SEERR_API_KEY=
# Seerr user the bot comments as (X-Api-User) + its display name (loop guard)
#SEERR_BOT_USER_ID=2
#SEERR_BOT_USERNAME=blitzcrank

# Optional services — tools are only registered when configured
SONARR_URL=http://sonarr.local:8989
SONARR_API_KEY=

RADARR_URL=http://radarr.local:7878
RADARR_API_KEY=

SABNZBD_URL=http://sabnzbd.local:8080
SABNZBD_API_KEY=

JELLYFIN_URL=http://jellyfin.local:8096
JELLYFIN_API_KEY=

# Discord — automation reports, /automation, and optional support inbox.
# Unset token = no bot and no command registration. Guild + watch channel are
# required when set. Guild commands are replaced on startup.
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=
# Text channel that holds the per-automation report threads (admin-only)
#DISCORD_WATCH_CHANNEL_ID=
# Optional text channel. Messages are triaged, then accepted messages get a
# private read-only agent thread. Enable Message Content Intent for the bot.
#DISCORD_INBOX_CHANNEL_ID=
# Model for private Discord conversations. Falls back to BLITZCRANK_MODEL.
#BLITZCRANK_DISCORD_MODEL=openai-codex/gpt-5.6-terra:medium
# Cheap triage model with no service/read tools. Falls back to the chat model.
#BLITZCRANK_DISCORD_TRIAGE_MODEL=openai-codex/gpt-5.6-luna:low
# Extra roles allowed to trigger automations; administrators always may
#DISCORD_ADMIN_ROLE_IDS=

# Codex web search — issue runs use the openai-codex subscription in auth.json.
# These defaults use Luna with high search context. Search does not set the
# model's reasoning effort.
#PI_CODEX_WEB_SEARCH_MODEL=gpt-5.6-luna
#PI_CODEX_WEB_SEARCH_CONTEXT_SIZE=high

# media_probe (ffprobe) — enabled only when media roots are set.
# Colon-separated absolute directories the probe may read (library + completed
# downloads). Everything outside them is rejected; symlinks are resolved first.
# ffprobe must be on PATH.
#BLITZCRANK_MEDIA_ROOTS=/mnt/media:/mnt/downloads/complete
