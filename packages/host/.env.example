BLITZCRANK_PORT=8484
#BLITZCRANK_DATA_DIR=data
# How many threads may run at once. One thread never runs twice at once.
#BLITZCRANK_MAX_PARALLEL_RUNS=4
# Required: provider/model[:thinking], e.g. openai/gpt-6-astra:medium
BLITZCRANK_MODEL=
# Required: a chat model for small jobs outside a run, such as naming a Discord
# or Fluxer thread, as provider/model[:thinking]. Thinking defaults to medium
# here too; :off suits these jobs, e.g. openai/gpt-5.4-mini:off
BLITZCRANK_HELPER_MODEL=
# Replies follow the language of the member's message. This one is the
# fallback when no message of theirs shows a language, and the language of the
# host's own notices, such as the queue and working lines.
#BLITZCRANK_LANGUAGE=German
# Comma-separated gateways to run: seerr (default), discord, fluxer, or any
# combination. Only the listed gateways' settings below are read.
#BLITZCRANK_GATEWAYS=seerr

# API keys, or use `pnpm auth login <provider>` for OAuth
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
# Defaults to <BLITZCRANK_DATA_DIR>/auth.json; must stay writable
#BLITZCRANK_AUTH_PATH=/var/lib/blitzcrank/auth.json
# Optional models.json for custom providers
#BLITZCRANK_MODELS_PATH=

# Seerr gateway (src/gateways/seerr/config.ts), when BLITZCRANK_GATEWAYS
# lists seerr.
# Required: the host comments and checks senders itself
SEERR_URL=http://jellyseerr.local:5055
SEERR_API_KEY=
# Sent by Seerr as the Authorization header
BLITZCRANK_WEBHOOK_SECRET=change-me
# Bot identity: X-Api-User and loop-guard display name
#SEERR_BOT_USER_ID=2
#SEERR_BOT_USERNAME=blitzcrank

# Discord gateway (src/gateways/chat-config.ts), when BLITZCRANK_GATEWAYS
# lists discord.
# Required: the bot's token from the developer portal
#DISCORD_BOT_TOKEN=
# Required: comma-separated ids of the channels the bot watches
#DISCORD_CHANNELS=
# Who may use the bot, by user id or role id. Either list admits a current
# guild member. Set at least one id here or in the admin lists below.
#DISCORD_ALLOWED_USERS=
#DISCORD_ALLOWED_ROLES=
# Admins, by user id or role id: members who may also have media removed
# that plays fine. An admin needs no entry above. Unset, nobody is an admin.
#DISCORD_ADMIN_USERS=
#DISCORD_ADMIN_ROLES=
# Required, no default: a classifier model as provider/model, e.g.
# opencode/jev-1.13 with OPENCODE_API_KEY
#DISCORD_TRIAGE_MODEL=
# How sure triage must be before an unmentioned message opens a thread,
# above 0 and at most 1
#DISCORD_TRIAGE_THRESHOLD=0.8

# Fluxer gateway (src/gateways/chat-config.ts and fluxer/gateway.ts), when
# BLITZCRANK_GATEWAYS lists fluxer.
# Required: the instance origin, e.g. https://fluxer.app or
# https://chat.example.com. The host reads /.well-known/fluxer from it.
#FLUXER_INSTANCE_URL=
# Required: the bot's token from User Settings > Applications
#FLUXER_BOT_TOKEN=
# Required: comma-separated ids of the channels the bot watches
#FLUXER_CHANNELS=
# Who may use the bot, by user id or role id. Either list admits a current
# guild member. Set at least one id here or in the admin lists below.
#FLUXER_ALLOWED_USERS=
#FLUXER_ALLOWED_ROLES=
# Admins, by user id or role id: members who may also have media removed
# that plays fine. An admin needs no entry above. Unset, nobody is an admin.
#FLUXER_ADMIN_USERS=
#FLUXER_ADMIN_ROLES=
# Required, no default: a classifier model as provider/model, e.g.
# opencode/jev-1.13 with OPENCODE_API_KEY
#FLUXER_TRIAGE_MODEL=
# How sure triage must be before an unmentioned message opens a thread,
# above 0 and at most 1
#FLUXER_TRIAGE_THRESHOLD=0.8

# Required: the Blitzcrank MCP server the agent reads and writes through.
# Sonarr, Radarr, SABnzbd, and Jellyfin credentials and the media roots now
# live in that server's environment, not here (packages/mcp/README.md).
BLITZCRANK_MCP_URL=http://127.0.0.1:8485/mcp
# Must equal the server's BLITZCRANK_MCP_TOKEN
BLITZCRANK_MCP_TOKEN=change-me

# firecrawl or none (default)
#BLITZCRANK_WEB_PROVIDER=none
#FIRECRAWL_API_KEY=fc-...
# Read only with the firecrawl provider. Defaults to the hosted API. Point it
# elsewhere only for tests against a fake Firecrawl, or at your own risk:
# Firecrawl fetches pages itself, so an instance inside your network lets a
# URL from any message reach internal services.
#FIRECRAWL_URL=https://api.firecrawl.dev
