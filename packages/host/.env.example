BLITZCRANK_PORT=8484
#BLITZCRANK_DATA_DIR=data
# How many threads may run at once. One thread never runs twice at once.
#BLITZCRANK_MAX_PARALLEL_RUNS=4
# Required: provider/model[:thinking], e.g. openai/gpt-6-astra:medium
BLITZCRANK_MODEL=
#BLITZCRANK_LANGUAGE=German

# API keys, or use `pnpm auth login <provider>` for OAuth
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
# Defaults to <BLITZCRANK_DATA_DIR>/auth.json; must stay writable
#BLITZCRANK_AUTH_PATH=/var/lib/blitzcrank/auth.json
# Optional models.json for custom providers
#BLITZCRANK_MODELS_PATH=

# Seerr gateway (src/gateways/seerr/config.ts).
# Required: the host comments and gates comments itself
SEERR_URL=http://jellyseerr.local:5055
SEERR_API_KEY=
# Sent by Seerr as the Authorization header
BLITZCRANK_WEBHOOK_SECRET=change-me
# Bot identity: X-Api-User and loop-guard display name
#SEERR_BOT_USER_ID=2
#SEERR_BOT_USERNAME=blitzcrank

# Required: the Blitzcrank MCP server the agent reads and writes through.
# Sonarr, Radarr, SABnzbd, and Jellyfin credentials and the media roots now
# live in that server's environment, not here (packages/mcp/README.md).
BLITZCRANK_MCP_URL=http://127.0.0.1:8485/mcp
# Must equal the server's BLITZCRANK_MCP_TOKEN
BLITZCRANK_MCP_TOKEN=change-me

# firecrawl or none (default); hosted API only
#BLITZCRANK_WEB_PROVIDER=none
#FIRECRAWL_API_KEY=fc-...
